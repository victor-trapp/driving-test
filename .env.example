# Copy to .env for local runs (`cp .env.example .env`), or set these in the
# Kubernetes ConfigMap. Every value has a sensible default. Variables already set in
# your shell take priority over this file.

# Where the server listens. 127.0.0.1 keeps it on this machine only. Set 0.0.0.0 to use
# it from a phone or another computer on your network (and set ADMIN_TOKEN too).
HOST=127.0.0.1
PORT=3000

# SQLite database and licensed hazard clips live here. Mount a persistent volume at
# this path in Docker/Kubernetes.
DATA_DIR=./data
# DATABASE_PATH=./data/theory.db
# MEDIA_DIR=./data/media

# Used for "today", streaks and daily activity.
APP_TIMEZONE=Europe/London

# Optional. When set, backup, import and reset need this token
# (entered on the Settings page). Recommended whenever HOST isn't 127.0.0.1.
# ADMIN_TOKEN=change-me

# Optional. Hostnames the app should answer to, comma-separated. localhost and IP
# addresses always work; anything else is refused to block DNS rebinding attacks.
# A leading dot allows subdomains, e.g. .home.arpa
# ALLOWED_HOSTS=theory.home.arpa

# Log one line per API request.
LOG_REQUESTS=true
